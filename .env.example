# Run npm run setup to generate a password hash and session secret.
APP_ORIGIN=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-generated-scrypt-hash
SESSION_SECRET=replace-with-generated-secret-at-least-32-characters
# Local development: ./storage. Coolify: /app/storage
STORAGE_PATH=./storage
# Decimal GB: 20 GB quota, 5 GB free-disk reserve, 1 GB per upload.
STORAGE_QUOTA_BYTES=20000000000
MIN_FREE_DISK_BYTES=5000000000
MAX_FILE_BYTES=1000000000
# Optional assistant: personal ChatGPT/Codex sign-in, no API key.
# In Compose, the worker URL is supplied automatically.
ASSISTANT_WORKER_URL=
# Generate with: openssl rand -hex 32. Use the same value on drive and worker.
ASSISTANT_WORKER_SECRET=
